};

const openAddModal = () => {
  isEditing.value = false;
  const attrs = initializeProjectAttributes();

  // Auto-fill "Date Entrée" with current date
  const dateEntreeAttr = projectAttributes.value.find(a => a.name === 'Date Entrée');
